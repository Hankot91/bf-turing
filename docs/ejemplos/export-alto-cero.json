{
  "name": "export-alto-cero",
  "description": "MT de alto nivel para +[-].",
  "endpoint": "POST /api/export",
  "httpStatus": 200,
  "request": {
    "code": "+[-]",
    "mode": "high",
    "cellSize": 256
  },
  "response": {
    "version": 1,
    "mode": "high",
    "states": [
      "q0",
      "q1",
      "q2",
      "q3",
      "qhalt"
    ],
    "alphabet": {
      "size": 256,
      "blank": 0
    },
    "initial": "q0",
    "accepting": [
      "qhalt"
    ],
    "transitions": [
      {"from": "q0", "read": "*", "to": "q1", "write": {"op": "inc"}, "move": "N"},
      {"from": "q1", "read": "0", "to": "qhalt", "write": {"op": "keep"}, "move": "N"},
      {"from": "q1", "read": "!0", "to": "q2", "write": {"op": "keep"}, "move": "N"},
      {"from": "q2", "read": "*", "to": "q3", "write": {"op": "dec"}, "move": "N"},
      {"from": "q3", "read": "0", "to": "qhalt", "write": {"op": "keep"}, "move": "N"},
      {"from": "q3", "read": "!0", "to": "q2", "write": {"op": "keep"}, "move": "N"}
    ]
  }
}
